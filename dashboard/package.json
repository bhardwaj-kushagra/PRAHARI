{
  "name": "prahari-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PRAHARI-SIM replay dashboard (all values are SIMULATION output)",
  "scripts": {
    "sync-recordings": "node scripts/sync-recordings.mjs",
    "predev": "npm run sync-recordings",
    "dev": "vite",
    "prebuild": "npm run sync-recordings",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.1"
  }
}
